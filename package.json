{
  "name": "congero",
  "version": "0.1.0",
  "description": "A roguelite canasta deckbuilder built with Angular 21 and BabylonJS",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --hmr=false",
    "build": "ng build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "ng:typecheck": "ng build --configuration development"
  },
  "devDependencies": {
    "@angular/build": "21.2.13",
    "@angular/cli": "21.2.13",
    "@angular/compiler-cli": "21.2.13",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "dependencies": {
    "@angular/animations": "21.2.13",
    "@angular/common": "21.2.13",
    "@angular/compiler": "21.2.13",
    "@angular/core": "21.2.13",
    "@angular/forms": "21.2.13",
    "@angular/platform-browser": "21.2.13",
    "@angular/platform-browser-dynamic": "21.2.13",
    "@angular/router": "21.2.13",
    "@angular/service-worker": "21.2.13",
    "@babylonjs/core": "9.10.1",
    "babylonjs": "9.10.1",
    "rxjs": "7.8.2",
    "zone.js": "0.16.2"
  }
}
